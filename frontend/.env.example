# Variables del cliente. Copia este archivo a .env (cp .env.example .env).
# IMPORTANTE: toda variable VITE_* se incrusta en el bundle público que descarga
# el navegador. NUNCA pongas aquí secretos (llaves de Gemini, tokens de Telegram, etc.).

# URL base de la API REST del backend (sin barra final).
VITE_API_URL=http://localhost:8080/api/v1
