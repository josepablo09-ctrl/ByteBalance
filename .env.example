# Plantilla de variables de entorno para ByteBalance.
# Copia este archivo a .env y completa los valores reales. NUNCA commitees .env.

# Entorno de ejecución: development | staging | production
APP_ENV=development

# Puerto HTTP del backend
APP_PORT=8080

# Número de proxies de confianza delante de la API (p. ej. 1 detrás de un ALB de AWS).
# Se usa para leer la IP real del cliente de X-Forwarded-For (límite de intentos de login).
# En local sin proxy: 0. Un valor mayor al real permite falsificar la IP.
TRUSTED_PROXY_HOPS=0

# Orígenes del frontend autorizados por CORS, separados por comas (esquema://host[:puerto]).
# Vacío desactiva CORS. Fuera de development solo se admite https. Nunca usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credenciales del contenedor PostgreSQL local (docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bytebalance
POSTGRES_PORT=5432

# Cadena de conexión a PostgreSQL (usar sslmode=require fuera de local)
DATABASE_URL=postgres://user:password@localhost:5432/bytebalance?sslmode=disable

# Secreto HS256 para firmar los tokens de acceso (JWT). Obligatorio, mínimo 32 bytes.
# Generar uno distinto por entorno con: openssl rand -base64 48
JWT_SECRET=

# Llave de Google Gemini API (solo backend)
GEMINI_API_KEY=your-gemini-api-key

# Token del bot de Telegram (obtenido con BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Chat ID de Telegram al que se envían notificaciones
TELEGRAM_CHAT_ID=your-telegram-chat-id
